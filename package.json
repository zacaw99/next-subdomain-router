{
	"name": "next-subdomain-router",
	"version": "1.0.1",
	"description": "Subdomain routing for Next.js 16 proxy.ts",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"keywords": [
		"nextjs",
		"next",
		"subdomain",
		"routing",
		"proxy",
		"middleware",
		"multi-tenant"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zacaw99/next-subdomain-router.git"
	},
	"homepage": "https://github.com/zacaw99/next-subdomain-router#readme",
	"bugs": {
		"url": "https://github.com/zacaw99/next-subdomain-router/issues"
	},
	"engines": {
		"node": ">=18.18"
	},
	"peerDependencies": {
		"next": ">=16.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"tsup": "^8.3.5",
		"typescript": "^5.9.0"
	},
	"scripts": {
		"build": "tsup",
		"clean": "rm -rf dist",
		"prepublishOnly": "npm run clean && npm run build"
	}
}
